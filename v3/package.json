    "dev": "esbuild src/main.js --bundle --format=iife --outfile=dist/deck.js --watch"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "three": "0.170.0"
  }
}
